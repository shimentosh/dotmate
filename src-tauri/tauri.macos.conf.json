{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DotMate",
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "dragDropEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "public.app-category.utilities",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "frameworks": [
        "bundle-dylibs/libsherpa-onnx-c-api.dylib",
        "bundle-dylibs/libonnxruntime.1.24.4.dylib"
      ]
    }
  }
}
