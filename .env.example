# DotMate reads NO .env file — there is no server and no runtime config file.
# The variables below are read from the PROCESS environment (set them in your shell
# or CI before the command). All are optional.

# Build time (Rust, read by src-tauri/src/sources.rs via option_env!):
# URL of a vendor-hosted Supertonic 3 archive built with
# src-tauri/scripts/pack-supertonic-archive.sh. Empty = Supertonic is hidden.
SUPERTONIC_ARCHIVE_URL=

# Build time (Cargo/whisper-rs): path to LLVM's bin dir if libclang is not found.
LIBCLANG_PATH=

# Build time (Cargo): lower parallelism on low-RAM machines.
CARGO_BUILD_JOBS=2

# Runtime (release builds, Windows): set to 1 to re-enable devtools and the
# WebView2 right-click menu for diagnosing a packaged build.
DOTMATE_DEVTOOLS=

# Runtime: explicit ffmpeg binary. The app sets this itself to its downloaded
# copy when present; set it only to use your own ffmpeg instead.
FFMPEG_PATH=
